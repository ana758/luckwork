{
  "version": 1,
  "sdk_version": "3.1.0",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://lntmbevuofxzyveeumvz.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "luck",
      "version": "0.1.0",
      "title": "luck"
    },
    "tools": [
      {
        "name": "list_tasks",
        "title": "List tasks",
        "description": "List LUCK tasks, optionally filtered by company and status.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "source": {
              "description": "Company filter.",
              "type": "string",
              "enum": [
                "angi",
                "devore",
                "bruna",
                "pessoal"
              ]
            },
            "status": {
              "description": "Status filter.",
              "type": "string",
              "enum": [
                "todo",
                "doing",
                "onhold",
                "done"
              ]
            },
            "limit": {
              "description": "Max rows (default 50).",
              "type": "integer",
              "minimum": 1,
              "maximum": 200
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "create_task",
        "title": "Create task",
        "description": "Create a new LUCK task for a company.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1,
              "description": "Task title."
            },
            "source": {
              "type": "string",
              "enum": [
                "angi",
                "devore",
                "bruna",
                "pessoal"
              ],
              "description": "Company."
            },
            "due_date": {
              "description": "Due date YYYY-MM-DD.",
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "due_time": {
              "description": "Due time HH:MM.",
              "type": "string",
              "pattern": "^\\d{2}:\\d{2}$"
            },
            "priority": {
              "type": "string",
              "enum": [
                "alta",
                "media",
                "baixa"
              ]
            },
            "notes": {
              "type": "string"
            }
          },
          "required": [
            "title",
            "source"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "update_task_status",
        "title": "Update task status",
        "description": "Change the status of a LUCK task (e.g. mark it done).",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Task id."
            },
            "status": {
              "type": "string",
              "enum": [
                "todo",
                "doing",
                "onhold",
                "done"
              ]
            }
          },
          "required": [
            "id",
            "status"
          ],
          "additionalProperties": false
        },
        "outputSchema": null
      },
      {
        "name": "list_meetings",
        "title": "List meetings",
        "description": "List upcoming LUCK meetings and appointments within the next N days.",
        "annotations": {
          "readOnlyHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "days": {
              "description": "Days ahead (default 7).",
              "type": "integer",
              "minimum": 1,
              "maximum": 60
            }
          },
          "additionalProperties": false
        },
        "outputSchema": null
      }
    ]
  }
}
